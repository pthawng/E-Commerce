# ==============================================================================
# Ray Paradis Monorepo - Production-Grade Root Gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
# Always ignore node_modules at all levels of the monorepo.
node_modules/
/node_modules/

# Package manager cache directories (but NEVER ignore lockfiles)
.npm/
.yarn/
.pnpm-store/

# ------------------------------------------------------------------------------
# Build & Compilation Output (Root-level/generic fallback)
# ------------------------------------------------------------------------------
# Ignore build outputs at the project root level.
dist/
build/
out/
.next/
.serverless/
.docusaurus/
.cache/

# TypeScript incremental compilation cache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Security, Keys & Secrets (CRITICAL PROTECTION)
# ------------------------------------------------------------------------------
# Block raw secrets, credentials, and environment configuration files.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# DO NOT ignore .env.* files that match example/template files
!.env.example
!.env.template
!.env.production.example

# Credentials & Key files
*.pem
*.key
*.pub
ssh_config
auth_token.json
.netrc
credentials.json
*.secret
secrets.yaml
secrets.yml

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
# Coverage output
coverage/
.nyc_output/

# Test reports
junit.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# Logs & Diagnostic Reports
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn-error.log*
lerna-debug.log*
logs/
panic.log

# ------------------------------------------------------------------------------
# IDE & System Editors
# ------------------------------------------------------------------------------
# VS Code (Allow sharing workspace settings, but ignore user/dev-specific settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/extensions.json

# IntelliJ / WebStorm
.idea/

# Editors swap and backup files
*.swp
*.swo
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# OS-Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Temporary Files
# ------------------------------------------------------------------------------
.tmp/
.temp/
bak/
tmp/
*.temp
*.backup

# ------------------------------------------------------------------------------
# Tooling & Agent Workspace Caches
# ------------------------------------------------------------------------------
.gemini/
.agents/
brain/
CORTEX_LOGS/

# ------------------------------------------------------------------------------
# Deployment / Hosting Platform Metadata
# ------------------------------------------------------------------------------
.vercel/
.netlify/