# ==============================================================================
# Ray Paradis Monorepo - FAANG-Standard L8 Gitignore
# ==============================================================================

# --- Dependencies ---
node_modules/
.npm/
.yarn/
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Build Artifacts ---
dist/
build/
out/
.next/
.serverless/
*.tsbuildinfo
*.eslintcache

# --- Security & Credentials (CRITICAL) ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.pub
ssh_config
auth_token.json
.netrc
credentials.json

# --- Database & Persistence ---
*.db
*.sqlite
/backend/prisma/migrations/backup/
/backend/src/generated/

# --- Infrastructure & Orchestration ---
.terraform/
*.tfstate
*.tfstate.*
.kube/config
*kubeconfig*
.helm/

# --- Testing & Coverage ---
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/
blob-report/
test-results/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/
panic.log

# --- IDE & Editors ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Temporary Files ---
.tmp/
.temp/
.cache/
bak/
tmp/

# --- Project Specific ---
/scripts/sandbox/
/backups/
/docs/site/
CORTEX_LOGS/
.gemini/
.agents/
brain/
