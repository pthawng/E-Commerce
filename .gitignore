# ==============================================================================
# Ray Paradis Monorepo - Comprehensive Gitignore
# ==============================================================================

# --- Dependencies ---
node_modules/
node_modules/
.npm/
.yarn/
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Build Artifacts ---
dist/
build/
out/
.next/
.serverless/
*.tsbuildinfo
*.eslintcache
.cache/

# --- Security & Credentials (CRITICAL) ---
.env
.env.local
.env.*.local
!*!.env.example
!*!.env.template
!*!.env.production.example
.pem
*.key
*.pub
ssh_config
auth_token.json
.netrc
credentials.json
*.secret
secrets.yaml
secrets.yml

# --- Database ---
*.db
*.sqlite
*.sqlite3
/data/
/database/*.db
/backend/prisma/migrations/backup/
/backend/src/generated/

# --- Infrastructure ---
.terraform/
*.tfstate
*.tfstate.*
.tfplan
.kube/config
*kubeconfig*
.helm/

# --- Testing ---
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn-error.log*
lerna-debug.log*
logs/
panic.log

# --- IDE & Editors ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Temporary Files ---
.tmp/
.temp/
bak/
tmp/
*.temp

# --- Project Specific ---
/scripts/sandbox/
/backups/
/docs/site/
CORTEX_LOGS/
.gemini/
.agents/
brain/
*.backup

# --- Docker ---
.dockerignore

# --- Cloud Deployments ---
.vercel/
.netlify/

# --- AI Service ---
/ai-service/model-cache/
/ai-service/*.duckdb
/ai-service/*.duckdb.wal