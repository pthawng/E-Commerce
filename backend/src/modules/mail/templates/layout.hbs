{{!-- layout.hbs --}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
  <title>{{subject}}</title>
  <style>
    body { margin:0; padding:0; background:#FAFAFA; font-family: 'Montserrat', sans-serif; font-weight: 300; letter-spacing: 0.01em; color: #070D2B; }
    .wrapper { width:100%; table-layout:fixed; padding:40px 0; background:#FAFAFA; }
    .main { background:#FFFFFF; width:100%; max-width:540px; margin:0 auto; border: 1px solid #EAEAEA; box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.04); }
    .spacer { height:32px; }
    .content { padding:40px; color:#070D2B; line-height:1.75; font-size:15px; }
    .logo-container { padding: 40px 40px 0 40px; text-align: center; }
    .divider { height: 1px; background: linear-gradient(90deg, transparent 0%, #EAEAEA 20%, #EAEAEA 80%, transparent 100%); margin: 24px 0; }
    .btn { display:inline-block; text-decoration:none; padding:14px 28px; background: transparent; border: 1px solid #0E1A58; color:#0E1A58; font-family: 'Montserrat', sans-serif; font-size: 13px; font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase; transition: all 0.3s ease; }
    h1, h2, h3 { font-family: 'Cormorant Garamond', serif; font-weight: 400; letter-spacing: 0.04em; color: #0E1A58; margin-top: 0; }
    .muted { color:#6b7280; font-size:13px; }
    .footer { padding:24px 40px 40px; font-size:12px; color:#9ca3af; text-align:center; font-family: 'Montserrat', sans-serif; letter-spacing: 0.05em; }
    .footer a { color: #CFA53E; text-decoration: none; }
    @media screen and (max-width:420px) {
      .content { padding:24px; font-size:14px; }
      .logo-container { padding-top: 24px; }
    }
  </style>
</head>
<body>
  <center class="wrapper">
    <table class="main" role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td class="logo-container">
          {{#if logoUrl}}
            <img src="{{logoUrl}}" alt="{{companyName}}" width="160" style="display:inline-block; border:0;" />
          {{else}}
            <h1 style="font-size:24px; letter-spacing: 0.25em; text-transform: uppercase; margin: 0; color: #0E1A58;">Ray Paradis</h1>
          {{/if}}
        </td>
      </tr>

      <tr>
        <td class="content">
          <div class="divider"></div>
          {{{body}}}
        </td>
      </tr>

      <tr>
        <td class="footer">
          <div class="divider" style="margin-top: 0;"></div>
          <div style="margin-bottom: 8px;">
            Trải nghiệm không gian xa xỉ tại <a href="https://rayparadis.com">rayparadis.com</a>
          </div>
          <div>
            Hỗ trợ đặc quyền: <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>
          </div>
          <div style="margin-top:16px; opacity: 0.6;">
            © {{companyName}} — Tôn vinh kiệt tác thời gian.
          </div>
        </td>
      </tr>
    </table>
  </center>
</body>
</html>
