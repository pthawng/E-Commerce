# ========================================
# RAY PARADIS - PRODUCTION ENVIRONMENT TEMPLATE
# ========================================
# IMPORTANT: THIS IS AN EXAMPLE FILE. DO NOT PUT ACTUAL SECRETS HERE.
# USE SERVER ENVIRONMENT VARIABLES OR A SECRET MANAGER.

# Server Configuration
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed origins
CORS_ORIGIN=https://yourstorefront.com,https://admin.yourstorefront.com

# Database
# Use a production-grade managed database with SSL enabled
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# JWT Configuration (ROTATE THESE REGULARLY)
# Generate long random strings (e.g., openssl rand -base64 64)
JWT_ACCESS_SECRET=your_32_plus_char_access_secret
JWT_REFRESH_SECRET=your_32_plus_char_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PAGINATION_SECRET=your_32_plus_char_pagination_secret

# Redis Configuration (Production Cluster/Managed Service)
REDIS_URL=rediss://:password@hostname:6379
REDIS_PASSWORD=your_redis_password
REDIS_TTL=1800000

# Mail Configuration
MAIL_PROVIDER=sendgrid
COMPANY_NAME=Ray Paradis
MAIL_FROM=no-reply@yourdomain.com
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Supabase Storage (Production Bucket)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=production-bucket

# Payment Configuration (PRODUCTION KEYS)
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=https://yourstorefront.com/payment/vnpay/callback
VNPAY_API_URL=https://merchant.vnpayment.vn/merchant_webapi/api/transaction

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=production
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Operational Hardening
SEED_ADMIN_PASSWORD=your_secure_seed_admin_password
ALLOW_PROD_SEED=false

# Frontend URL
FRONTEND_URL=https://yourstorefront.com
