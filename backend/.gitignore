# ==============================================================================
# @ray-paradis/backend - Production-Grade Local Gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Build Targets
# ------------------------------------------------------------------------------
node_modules/
dist/
build/

# ------------------------------------------------------------------------------
# Runtime & Process State
# ------------------------------------------------------------------------------
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# Environment Configurations (Bảo mật - Local only)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
!.env.production.example

# ------------------------------------------------------------------------------
# Prisma ORM Artifacts
# ------------------------------------------------------------------------------
# Ignore custom generated prisma clients or schemas, but NEVER ignore migrations.
src/generated/
generated/prisma/
# SQLite databases if used for local tests
*.db
*.db-journal

# ------------------------------------------------------------------------------
# Logs & Diagnostic Reports
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------------------------------------------
# Temporary Diagnostic / Sandbox Scripts
# ------------------------------------------------------------------------------
# Prevents accidental commit of local debugging or ad-hoc querying scripts
/scripts/sandbox/
check_*.js
scan_*.js
hunt_*.js
simulate_*.js
find_*.js
verify_*.js
debug_*.js
test_*.js
query_*.js
get_*.js
list_*.js
count_*.js
clean_*.js
check_*.ts
scan_*.ts
hunt_*.ts
simulate_*.ts
find_*.ts
verify_*.ts
debug_*.ts
test_*.ts
query_*.ts
get_*.ts
list_*.ts
count_*.ts
clean_*.ts