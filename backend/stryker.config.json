{
    "packageManager": "npm",
    "reporters": [
        "html",
        "clear-text",
        "progress"
    ],
    "testRunner": "jest",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true
    },
    "checkers": [
        "typescript"
    ],
    "tsconfigFile": "tsconfig.json",
    "mutate": [
        "src/modules/security/ownership.registry.ts",
        "src/modules/auth/auth.service.ts"
    ],
    "thresholds": {
        "high": 95,
        "low": 80,
        "break": 90
    }
}