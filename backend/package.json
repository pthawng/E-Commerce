{
  "name": "@ray-paradis/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/configs/jest-integration.json --runInBand --forceExit",
    "test:chaos": "jest --config ./test/configs/jest-chaos.json",
    "test:mutation": "stryker run test/configs/stryker.config.json",
    "test:load": "node test/load/autocannon-stress.js",
    "start:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "dotenv -e .env.development -- npx prisma migrate dev",
    "prisma:migrate:prod": "dotenv -e .env.production -- npx prisma migrate deploy",
    "seed": "npx ts-node src/prisma/orchestrator.ts",
    "db:reset": "npx ts-node src/prisma/reset-db.ts",
    "prisma:migrate:prod:local": "dotenv -e .env.production -- npx prisma migrate deploy",
    "prisma:studio:prod": "dotenv -e .env.production -- npx prisma studio",
    "db:reset:prod": "dotenv -e .env.production -- npm run db:reset -- --force-production-reset",
    "release": "ts-node ../scripts/release.ts"
  },
  "dependencies": {
    "@bull-board/api": "^7.0.0",
