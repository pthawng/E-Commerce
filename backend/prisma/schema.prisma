generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Permission {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  createdAt       DateTime          @default(now())
  module          PermissionModule?
  action          String?           @unique
  roles           RolePermission[]
  userPermissions UserPermission[]
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  slug            String           @unique
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  assignedBy   String?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId], map: "idx_user_roles_user")
}

model UserPermission {
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  assignedAt   DateTime         @default(now())
  assignedBy   String?
  effect       PermissionEffect @default(ALLOW)
  reason       String?
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId], map: "idx_user_permissions_perm")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  phone               String?              @unique
  passwordHash        String
  fullName            String
  isActive            Boolean              @default(true)
  isEmailVerified     Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  userType            UserType             @default(CUSTOMER)
  avatarUrl           String?
  bio                 String?
  nickName            String?
  segment             LuxurySegment?       @default(PROSPECT)
  auditLogs           AuditLog[]
  preferences         ClientPreference[]
  discountUsages      DiscountUsage[]
  orders              Order[]
  posts               Post[]
  refreshTokens       RefreshToken[]
  resetPasswordTokens ResetPasswordToken[]
  reviews             Review[]
  lifeEvents          UserLifeEvent[]
  userPermissions     UserPermission[]
  userRoles           UserRole[]
  verifyEmailTokens   VerifyEmailToken[]

  @@index([email], map: "idx_users_active_email")
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  token         String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  fingerprint   String?
  ipAddress     String?
  parentJti     String?   @db.Uuid
  revokedReason String?
  riskScore     Float     @default(0)
  version       Int       @default(1)
  revokedAt     DateTime?
  deviceName    String?
  deviceType    String?
  userAgent     String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentJti])
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @db.Uuid

  @@index([key])
  @@map("system_settings")
}

model CurrencyRate {
  id             String   @id @default(uuid()) @db.Uuid
  baseCurrency   String   @default("VND")
  targetCurrency String
  rate           Decimal  @db.Decimal(19, 6)
  source         String?
  fetchedAt      DateTime @default(now())

  @@index([baseCurrency, targetCurrency])
  @@index([fetchedAt])
  @@map("currency_rates")
}

model VerifyEmailToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(50)
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResetPasswordToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id           String            @id @default(uuid()) @db.Uuid
  parentId     String?           @db.Uuid
  name         Json
  slug         String            @unique
  isActive     Boolean           @default(true)
  order        Int               @default(0)
  path         String?
  level        Int?
  parent       Category?         @relation("CategoryToCategory", fields: [parentId], references: [id])
  children     Category[]        @relation("CategoryToCategory")
  productLinks ProductCategory[]

  @@index([parentId])
  @@index([slug])
  @@index([name], type: Gin)
  @@map("categories")
}

model Attribute {
  id         String             @id @default(uuid()) @db.Uuid
  code       String             @unique
  name       Json
  filterType AttributeInputType @default(select)
  values     AttributeValue[]

  @@index([name], type: Gin)
}

model AttributeValue {
  id                String                  @id @default(uuid()) @db.Uuid
  attributeId       String                  @db.Uuid
  value             Json
  metaValue         String?
  order             Int                     @default(0)
  attribute         Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantAttributes VariantAttributeValue[]

  @@index([attributeId])
  @@index([value], type: Gin)
}

model Product {
  id              String            @id @default(uuid()) @db.Uuid
  name            Json
  slug            String            @unique
  description     Json?
  displayPriceMin Decimal?          @db.Decimal(19, 2)
  displayPriceMax Decimal?          @db.Decimal(19, 2)
  hasVariants     Boolean           @default(true)
  isActive        Boolean           @default(true)
  isFeatured      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  deletedAt       DateTime?
  media           ProductMedia[]
  variants        ProductVariant[]
  reviews         Review[]
  categories      ProductCategory[]

  @@index([slug], map: "idx_products_slug")
  @@index([name], type: Gin)
  @@map("products")
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
  @@map("product_categories")
}

model ProductVariant {
  id             String                  @id @default(uuid()) @db.Uuid
  productId      String                  @db.Uuid
  sku            String                  @unique
  variantTitle   Json?
  price          Decimal                 @db.Decimal(19, 2)
  compareAtPrice Decimal?                @db.Decimal(19, 2)
  costPrice      Decimal?                @db.Decimal(19, 2)
  weightGram     Decimal?                @db.Decimal(19, 2)
  isDefault      Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  position       Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now())
  deletedAt      DateTime?
  thumbnailUrl   String?
  inventoryItems InventoryItem[]
  inventoryLogs  InventoryLog[]
  transfers      InventoryTransfer[]
  orderItems     OrderItem[]
  physicalItems  PhysicalItem[]
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes     VariantAttributeValue[]
  cartItems      CartItem[]
  media          ProductMedia[]          @relation("ProductMediaToProductVariant")

  @@index([productId], map: "idx_variants_product_id")
  @@index([sku], map: "idx_variants_sku")
  @@index([price], map: "idx_variants_price")
  @@index([variantTitle], type: Gin)
}

model VariantAttributeValue {
  variantId        String         @db.Uuid
  attributeValueId String         @db.Uuid
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId, variantId], map: "idx_variant_attr_lookup")
}

model ProductMedia {
  id          String           @id @default(uuid()) @db.Uuid
  productId   String           @db.Uuid
  url         String
  type        MediaType        @default(image)
  altText     Json?
  isThumbnail Boolean          @default(false)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants    ProductVariant[] @relation("ProductMediaToProductVariant")

  @@index([productId, order], map: "idx_product_media_product")
}

model Warehouse {
  id            String              @id @default(uuid()) @db.Uuid
  name          String
  code          String              @unique
  address       Json?
  isActive      Boolean             @default(true)
  inventory     InventoryItem[]
  locations     InventoryLocation[]
  inventoryLogs InventoryLog[]
  transfersFrom InventoryTransfer[] @relation("TransferFrom")
  transfersTo   InventoryTransfer[] @relation("TransferTo")
}

model InventoryLocation {
  id            String              @id @default(uuid()) @db.Uuid
  warehouseId   String              @db.Uuid
  name          String
  code          String              @unique
  type          LocationType        @default(SHELF)
  parentId      String?             @db.Uuid
  parent        InventoryLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children      InventoryLocation[] @relation("LocationHierarchy")
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  physicalItems PhysicalItem[]

  @@index([warehouseId])
}

model PhysicalItem {
  id               String             @id @default(uuid()) @db.Uuid
  productVariantId String             @db.Uuid
  locationId       String?            @db.Uuid
  serialNumber     String?            @unique
  rfidTag          String?            @unique
  status           ItemStatus         @default(AVAILABLE)
  integrityHash    String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orderItemId      String?            @db.Uuid
  location         InventoryLocation? @relation(fields: [locationId], references: [id])
  orderItem        OrderItem?         @relation(fields: [orderItemId], references: [id])
  productVariant   ProductVariant     @relation(fields: [productVariantId], references: [id])

  @@index([productVariantId])
  @@index([status])
}

model InventoryItem {
  id               String         @id @default(uuid()) @db.Uuid
  productVariantId String         @db.Uuid
  warehouseId      String         @db.Uuid
  quantity         Int            @default(0)
  reservedQuantity Int            @default(0)
  shelfLocation    String?
  updatedAt        DateTime       @default(now())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  logs             InventoryLog[]

  @@unique([productVariantId, warehouseId])
  @@index([productVariantId], map: "idx_inventory_variant")
}

model InventoryLog {
  id               String          @id @default(uuid()) @db.Uuid
  inventoryItemId  String          @db.Uuid
  productVariantId String?         @db.Uuid
  warehouseId      String?         @db.Uuid
  actionType       ActionType
  quantityChange   Int
  referenceId      String?
  actorId          String?         @db.Uuid
  note             String?
  createdAt        DateTime        @default(now())
  afterQuantity    Int
  beforeQuantity   Int
  referenceType    String?
  inventoryItem    InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@index([productVariantId, createdAt], map: "idx_inv_logs_variant")
  @@index([referenceId], map: "idx_inv_logs_ref")
}

model InventoryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @db.Uuid
  variantId   String            @db.Uuid
  quantity    Int
  expiresAt   DateTime
  status      ReservationStatus @default(active)
  createdAt   DateTime          @default(now())
  warehouseId String            @db.Uuid
  sessionId   String?           @db.VarChar(100)
  userId      String?           @db.Uuid
  cartItemId  String?           @db.Uuid
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([expiresAt, status], map: "idx_reservation_cleanup")
  @@index([orderId], map: "idx_reservation_order")
  @@index([userId, sessionId], map: "idx_reservation_owner")
  @@map("inventory_reservations")
}

model InventoryTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  variantId       String         @db.Uuid
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  quantity        Int
  status          String         @default("completed")
  note            String?
  actorId         String?        @db.Uuid
  createdAt       DateTime       @default(now())
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  productVariant  ProductVariant @relation(fields: [variantId], references: [id])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @db.Uuid
  sessionId String?    @db.VarChar(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  expiresAt DateTime?
  version   Int        @default(1)
  items     CartItem[]

  @@unique([userId, sessionId])
  @@map("carts")
}

model CartItem {
  id               String         @id @default(uuid()) @db.Uuid
  cartId           String         @db.Uuid
  productVariantId String         @db.Uuid
  quantity         Int            @default(1)
  cachedPrice      Decimal        @db.Decimal(19, 2)
  currency         String         @default("VND")
  discountSnapshot Json?
  taxRate          Decimal?       @db.Decimal(5, 2)
  addedAt          DateTime       @default(now())
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

model IdempotencyRecord {
  idempotencyKey String   @unique @db.VarChar(255)
  responseBody   Json?
  statusCode     Int?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@map("idempotency_records")
}

model ShippingMethod {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  providerCode String? @db.VarChar(50)
  baseFee      Decimal @default(0) @db.Decimal(19, 2)
  description  Json?
  rules        Json?
  isActive     Boolean @default(true)
  position     Int     @default(0)
  orders       Order[]
}

model Order {
  id                  String                 @id @default(uuid()) @db.Uuid
  code                String                 @unique
  userId              String?                @db.Uuid
  status              OrderStatusEnum        @default(PENDING_PAYMENT)
  paymentStatus       PaymentStatusEnum      @default(unpaid)
  shippingAddress     Json
  billingAddress      Json?
  shippingMethodId    String?                @db.Uuid
  shippingMethodName  String?
  trackingCode        String?
  estimatedDeliveryAt DateTime?
  baseCurrency        String                 @default("VND") @map("currency")
  subTotal            Decimal                @db.Decimal(19, 2)
  shippingFee         Decimal                @default(0) @db.Decimal(19, 2)
  discountAmount      Decimal                @default(0) @db.Decimal(19, 2)
  taxAmount           Decimal                @default(0) @db.Decimal(19, 2)
  totalAmount         Decimal                @db.Decimal(19, 2)
  note                String?
  cancelReason        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now())
  confirmedAt         DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  paymentDeadline     DateTime?
  paymentMethod       PaymentMethodEnum?
  sessionId           String?                @db.VarChar(100)
  idempotencyKey      String?                @unique @db.VarChar(100)
  retryCount          Int                    @default(0)
  guestEmail          String?                @db.VarChar(255)
  stateMetadata       Json?
  displayCurrency     String                 @default("VND")
  exchangeRate        Decimal                @default(1.0) @db.Decimal(19, 6)
  discountUsages      DiscountUsage[]
  shippingMethod      ShippingMethod?        @relation(fields: [shippingMethodId], references: [id])
  user                User?                  @relation(fields: [userId], references: [id])
  items               OrderItem[]
  timelines           OrderTimeline[]
  payments            Payment[]
  transactions        PaymentTransaction[]
  refunds             Refund[]
  reviews             Review[]
  reservations        InventoryReservation[]

  @@index([userId])
  @@index([sessionId])
  @@index([status, paymentDeadline])
  @@index([code])
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @db.Uuid
  productVariantId String?         @db.Uuid
  productName      String
  sku              String
  variantTitle     Json
  thumbnailUrl     String?
  quantity         Int             @default(1)
  price            Decimal         @db.Decimal(19, 2)
  totalLine        Decimal         @default(0) @db.Decimal(19, 2)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  physicalItems    PhysicalItem[]

  @@index([orderId])
}

model PaymentTransaction {
  id                    String                @id @default(uuid()) @db.Uuid
  orderId               String                @db.Uuid
  amount                Decimal               @db.Decimal(19, 2)
  currency              String                @default("VND")
  type                  TransactionTypeEnum
  status                TransactionStatusEnum @default(pending)
  provider              String
  method                String?
  transactionCode       String?               @unique
  gatewayResponse       Json?
  note                  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now())
  reconciliationStatus  ReconciliationStatus  @default(UNVERIFIED)
  amountUsd             Decimal?              @db.Decimal(19, 2)
  captureId             String?               @unique
  exchangeRate          Decimal?              @db.Decimal(19, 6)
  paymentId             String?               @db.Uuid
  providerTransactionId String?               @unique
  rawPayload            Json?
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment               Payment?              @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([transactionCode])
  @@index([paymentId])
}

model OrderTimeline {
  id          String           @id @default(uuid()) @db.Uuid
  orderId     String           @db.Uuid
  action      String
  fromStatus  OrderStatusEnum?
  toStatus    OrderStatusEnum?
  description String?
  actorId     String?          @db.Uuid
  actorType   String           @default("system")
  metadata    Json?
  createdAt   DateTime         @default(now())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Review {
  id           String        @id @default(uuid()) @db.Uuid
  productId    String        @db.Uuid
  userId       String?       @db.Uuid
  orderId      String        @db.Uuid
  rating       Int           @db.SmallInt
  title        String?
  content      String?
  status       String        @default("pending")
  helpfulCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  order        Order         @relation(fields: [orderId], references: [id])
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  reviewMedia  ReviewMedia[]

  @@unique([orderId, productId])
  @@index([productId], map: "idx_reviews_product_status")
}

model ReviewMedia {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @db.Uuid
  url       String
  type      String   @default("image")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Discount {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique
  name              String
  description       String?
  type              String
  value             Decimal         @db.Decimal(19, 2)
  maxDiscountAmount Decimal?        @db.Decimal(19, 2)
  startAt           DateTime
  endAt             DateTime?
  usageLimit        Int?
  usageCount        Int             @default(0)
  usageLimitPerUser Int             @default(1)
  minOrderValue     Decimal         @default(0) @db.Decimal(19, 2)
  isActive          Boolean         @default(true)
  appliesTo         Json            @default("{}")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  discountUsages    DiscountUsage[]
}

model DiscountUsage {
  id             String   @id @default(uuid()) @db.Uuid
  discountId     String   @db.Uuid
  userId         String   @db.Uuid
  orderId        String   @db.Uuid
  usedAt         DateTime @default(now())
  discountAmount Decimal  @db.Decimal(19, 2)
  discount       Discount @relation(fields: [discountId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, discountId])
  @@index([userId, discountId], map: "idx_discount_usage_check")
}

model Post {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique
  title           String
  excerpt         String?
  content         String?
  thumbnailUrl    String?
  authorId        String?   @db.Uuid
  status          String    @default("draft")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  author          User?     @relation(fields: [authorId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  action      String
  entityTable String
  entityId    String
  createdAt   DateTime @default(now())
  after       Json?
  before      Json?
  metadata    Json?
  user        User?    @relation(fields: [userId], references: [id])

  @@index([entityTable, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created")
}

model Refund {
  id                    String       @id @default(uuid()) @db.Uuid
  orderId               String       @db.Uuid
  paymentId             String?      @db.Uuid
  amount                Decimal      @db.Decimal(19, 2)
  currency              String       @default("VND")
  status                RefundStatus @default(PENDING)
  externalTransactionId String?      @unique
  reason                String?
  metadata              Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([externalTransactionId])
}

model Payment {
  id           String                  @id @default(uuid()) @db.Uuid
  orderId      String                  @db.Uuid
  status       PaymentProcessingStatus @default(INIT)
  verifiedAt   DateTime?
  errorLog     String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  order        Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([orderId])
}

model DataSeedHistory {
  id        String   @id @default(uuid()) @db.Uuid
  version   String   @unique
  name      String
  appliedAt DateTime @default(now())
  checksum  String?

  @@map("data_seed_history")
}

model EmailOutbox {
  id                String        @id @default(uuid()) @db.Uuid
  eventType         String
  recipient         String
  subject           String
  templateName      String
  templateVersion   String        @default("v1")
  context           Json
  status            OutboxStatus  @default(PENDING)
  provider          String?
  providerMessageId String?       @unique
  attempts          Int           @default(0)
  lastError         String?
  idempotencyKey    String        @unique
  scheduledAt       DateTime      @default(now())
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  parentOutboxId    String?       @db.Uuid
  parentOutbox      EmailOutbox?  @relation("OutboxOverrides", fields: [parentOutboxId], references: [id])
  childOutboxes     EmailOutbox[] @relation("OutboxOverrides")

  @@index([status, scheduledAt])
  @@map("email_outbox")
}

model DomainEventOutbox {
  id          String            @id @default(uuid()) @db.Uuid
  eventType   String
  payload     Json
  status      EventOutboxStatus @default(PENDING)
  retryCount  Int               @default(0)
  lastError   String?
  createdAt   DateTime          @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@map("domain_event_outbox")
}

model LedgerAccount {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique
  name         String
  type         AccountType
  currency     String              @default("VND")
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  transactions LedgerTransaction[]
}

model JournalEntry {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @unique
  description   String?
  referenceId   String?
  referenceType String?
  status        JournalStatus       @default(DRAFT)
  postedAt      DateTime?
  createdBy     String?             @db.Uuid
  createdAt     DateTime            @default(now())
  lines         LedgerTransaction[]
}

model LedgerTransaction {
  id        String        @id @default(uuid()) @db.Uuid
  journalId String        @db.Uuid
  accountId String        @db.Uuid
  debit     Decimal       @default(0) @db.Decimal(19, 2)
  credit    Decimal       @default(0) @db.Decimal(19, 2)
  note      String?
  createdAt DateTime      @default(now())
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  journal   JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@index([accountId])
}

model TransactionAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @db.Uuid
  action        String
  beforeStatus  String?
  afterStatus   String?
  actorId       String?  @db.Uuid
  actorType     String   @default("system")
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())
}

model ClientPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  category  String
  value     String
  intensity Int      @default(5)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserLifeEvent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  eventType        String
  eventDate        DateTime
  remindDaysBefore Int      @default(7)
  metadata         Json?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventDate])
}

