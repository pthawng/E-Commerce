# ================================================================
#  RAY PARADIS — ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
#  Copy this file to .env.development (local) or .env.production
#  The app loads .env.${NODE_ENV} automatically.
#
#  Values marked [REQUIRED] have no defaults — the app will crash
#  without them. Everything else has a safe fallback.
# ================================================================

# ── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development                       # development | production | test
CORS_ORIGIN=http://localhost:5173          # Comma-separated origins
FRONTEND_URL=http://localhost:5173         # [REQUIRED] Used for payment redirects & emails
BACKEND_PUBLIC_URL=http://localhost:4000   # Public-facing API base URL

# ── Database ────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce?schema=public

# ── Authentication (JWT) ────────────────────────────────────────
# [REQUIRED] Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=your_64_char_hex_secret
JWT_REFRESH_SECRET=your_64_char_hex_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PAGINATION_SECRET=your_32_plus_char_secret

# Checkout token (guest order access)
JWT_CHECKOUT_SECRET=your_32_plus_char_secret
JWT_CHECKOUT_EXPIRES_IN=15m

# ── Redis ───────────────────────────────────────────────────────
# Option A: Structured (local dev)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# Option B: Full URL (production / managed Redis)
# REDIS_URL=rediss://:password@hostname:6379

REDIS_TTL=1800000                          # Cache TTL in ms (30 min)

# ── Mail ────────────────────────────────────────────────────────
MAIL_PROVIDER=smtp                         # smtp | sendgrid
COMPANY_NAME=Ray Paradis
MAIL_FROM=noreply@rayparadis.test          # [REQUIRED]
MAIL_FROM_NAME=Ray Paradis

# SMTP (dev: Mailpit on port 1025 / prod: Gmail, SES, etc.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SendGrid (set MAIL_PROVIDER=sendgrid to use)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ── OAuth (Customer Login) ──────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
FACEBOOK_OAUTH_CLIENT_ID=your_facebook_client_id
FACEBOOK_OAUTH_CLIENT_SECRET=your_facebook_client_secret
OAUTH_STATE_TTL_SECONDS=600

# ── Storage (Supabase) ─────────────────────────────────────────
# [REQUIRED]
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=your-bucket-name

# ── Currency ────────────────────────────────────────────────────
SYSTEM_BASE_CURRENCY=VND
CURRENCY_API_URL=https://v6.exchangerate-api.com/v6/YOUR_KEY/latest/{base}

# ── Payment: VNPay ──────────────────────────────────────────────
# Sandbox: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/payment/vnpay/callback
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ── Payment: PayPal ─────────────────────────────────────────────
# Sandbox: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox                        # sandbox | live
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# ── Payment: VietQR / Bank Transfer ────────────────────────────
VIETQR_BANK_BIN=970422
VIETQR_BANK_ACCOUNT_NO=0123456789
VIETQR_BANK_ACCOUNT_NAME=RAY PARADIS
VIETQR_TEMPLATE=compact
VIETQR_EXPIRE_MINUTES=20
VIETQR_WEBHOOK_SECRET=your_webhook_secret
VIETQR_WEBHOOK_IPS=113.160.92.202,113.160.92.203,27.72.147.196

# ── AI Service ──────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:4100
AI_QUERY_TIMEOUT_MS=500
AI_EMBED_TIMEOUT_MS=3000
AI_SEARCH_TIMEOUT_MS=800
AI_SEARCH_CACHE_TTL_MS=120000              # 2 min
AI_RECOMMENDATION_CACHE_TTL_MS=600000      # 10 min
AI_CHAT_TIMEOUT_MS=60000                   # 60s
INTERNAL_SERVICE_TOKEN=your_internal_service_token

# ── Operational Hardening ───────────────────────────────────────
TRUST_PROXY_DEPTH=1                        # Set to proxy depth in production
SEED_ADMIN_PASSWORD=your_secure_admin_seed_password_min_8_chars
ALLOW_PROD_SEED=false
